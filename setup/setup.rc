#include <winres.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PP_VERSION_MAJOR,PP_VERSION_MINOR,PP_VERSION_PATCH,0
 PRODUCTVERSION PP_VERSION_MAJOR,PP_VERSION_MINOR,PP_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Plugin Properties setup"
            VALUE "FileVersion", PP_VERSION_STR
            VALUE "InternalName", "PluginPropertiesSetup"
            VALUE "OriginalFilename", "PluginPropertiesSetup.exe"
            VALUE "ProductName", "Plugin Properties"
            VALUE "ProductVersion", PP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
