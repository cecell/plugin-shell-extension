#include <winres.h>

// The manifest (resource 2, comctl32 v6) is merged in by the linker from
// PluginShellExtension.manifest and activated per thread by property_window.cpp.

// Subrecord patterns for the ITM check (embedded_patterns.cpp).
101 RCDATA "../data/itm_patterns.json"


VS_VERSION_INFO VERSIONINFO
 FILEVERSION PSE_VERSION_MAJOR,PSE_VERSION_MINOR,PSE_VERSION_PATCH,0
 PRODUCTVERSION PSE_VERSION_MAJOR,PSE_VERSION_MINOR,PSE_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Plugin Shell Extension shell extension"
            VALUE "FileVersion", PSE_VERSION_STR
            VALUE "InternalName", "PluginShellExtension"
            VALUE "OriginalFilename", "PluginShellExtension.dll"
            VALUE "ProductName", "Plugin Shell Extension"
            VALUE "ProductVersion", PSE_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
