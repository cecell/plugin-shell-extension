#include <winres.h>

// The manifest (resource 2, comctl32 v6) is merged in by the linker from
// PluginProperties.manifest and activated per thread by property_window.cpp.


VS_VERSION_INFO VERSIONINFO
 FILEVERSION PP_VERSION_MAJOR,PP_VERSION_MINOR,PP_VERSION_PATCH,0
 PRODUCTVERSION PP_VERSION_MAJOR,PP_VERSION_MINOR,PP_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Plugin Properties shell extension"
            VALUE "FileVersion", PP_VERSION_STR
            VALUE "InternalName", "PluginProperties"
            VALUE "OriginalFilename", "PluginProperties.dll"
            VALUE "ProductName", "Plugin Properties"
            VALUE "ProductVersion", PP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
